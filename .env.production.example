# ==============================================================================
# AegisPulse Production Environment Configuration Template
# Copy to .env or .env.production and customize for your deployment environment
# ==============================================================================

# Node Environment
NODE_ENV=production

# API Server Bindings
PORT=3000
HOST=0.0.0.0

# SQLite Persistence Path (Mounted volume inside container)
AEGIS_DB_PATH=/data/aegispulse.db

# Logging Configuration (fatal | error | warn | info | debug | trace)
LOG_LEVEL=info

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGIN=https://aegispulse.hospital.org

# JWT Authentication Secret (Set a strong 256-bit random key in production)
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_in_production

# Telemetry Broadcaster Replay Window Capacity
BROADCASTER_BUFFER_CAPACITY=1000

# Edge Offline Sync Deduplication History Limit
SYNC_MAX_KEY_HISTORY=10000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
