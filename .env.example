# ==============================================================================
# AegisPulse Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env for local development overrides:
#    cp .env.example .env
# 2. Never commit .env or any secret keys to version control.
# 3. In production, secrets must be injected securely via a secrets manager
#    (e.g., Kubernetes Secrets, AWS Secrets Manager, HashiCorp Vault).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Runtime Environment
# ------------------------------------------------------------------------------
# Defines execution mode: development | test | staging | production | demo
# In production/staging, strict configuration validation is enforced at startup.
NODE_ENV=development

# API HTTP & WebSocket listener port
# Development default: 3001. Production container default: 3000.
PORT=3001

# Network interface binding
# Development: localhost. Production container: 0.0.0.0.
HOST=localhost

# ------------------------------------------------------------------------------
# 2. Persistence & Storage
# ------------------------------------------------------------------------------
# Path to SQLite database file.
# Development/Test: Defaults to ':memory:' (ephemeral in-memory database).
# Production/Staging: REQUIRED. Must be a persistent volume path (e.g. /data/aegispulse.db).
# Production startup FAILS if unset or set to ':memory:' to prevent clinical data loss.
AEGIS_DB_PATH=:memory:

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
# Cryptographic secret for signing and verifying JWT authentication tokens.
# Development/Test: OPTIONAL (safe internal development secret is used by default).
# Production/Staging: REQUIRED (minimum 32 characters / 256 bits).
# Production startup FAILS if missing, shorter than 32 chars, or matching placeholder text.
# Generate a production key with: openssl rand -base64 32
JWT_SECRET=

# Allowed Cross-Origin Resource Sharing (CORS) origins (comma-separated).
# Development: OPTIONAL (defaults to http://localhost:5173, http://localhost:3000, http://localhost:3001).
# Production/Staging: REQUIRED (must be explicit HTTPS hospital domains, e.g. https://aegispulse.hospital.org).
# Production startup FAILS if unset, containing wildcard '*', or containing 'localhost'.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:3001

# ------------------------------------------------------------------------------
# 4. Security Lockdown Flags (Development & Testing Only)
# ------------------------------------------------------------------------------
# Allows synthetic 'role:<ROLE>' tokens without JWT signature verification.
# Allowed ONLY in development/test. Production startup FAILS if set to true.
ALLOW_DEV_TEST_TOKENS=false

# Allows impersonation via unverified HTTP headers ('x-user-role', 'x-user-id').
# Allowed ONLY in development/test. Production startup FAILS if set to true.
ALLOW_HEADER_AUTH=false

# ------------------------------------------------------------------------------
# 5. Telemetry & Streaming Tuning
# ------------------------------------------------------------------------------
# Capacity of in-memory telemetry event replay ring buffer for reconnecting clients.
BROADCASTER_BUFFER_CAPACITY=1000

# Edge offline synchronization deduplication key cache capacity.
SYNC_MAX_KEY_HISTORY=10000

# Inbound HTTP request timeout in milliseconds before HTTP 504 Gateway Timeout.
REQUEST_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 6. Rate Limiting & Observability
# ------------------------------------------------------------------------------
# Sliding window duration in milliseconds.
RATE_LIMIT_WINDOW_MS=60000

# Maximum permitted requests per IP per window (health checks are unthrottled).
RATE_LIMIT_MAX_REQUESTS=300

# Logging level: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Suppress console logging during automated test runs
SILENT_LOGS=false

# ------------------------------------------------------------------------------
# 7. Telemetry Gating Thresholds
# ------------------------------------------------------------------------------
MIN_OPTICAL_CONFIDENCE_THRESHOLD=0.60
MIN_OPTICAL_SNR_THRESHOLD_DB=1.0

# ------------------------------------------------------------------------------
# 8. Frontend Web Application
# ------------------------------------------------------------------------------
# Base URL for API requests from the web dashboard.
# Development: http://localhost:3001 (or proxied via Vite at http://localhost:5173).
# Production: In production Nginx deployment, relative path (/api) is used.
VITE_API_URL=http://localhost:3001
