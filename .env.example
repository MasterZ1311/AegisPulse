# AegisPulse Environment Configuration Template
# Copy to .env for local overrides. NEVER commit real production secrets to git.

# Runtime & Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Security & Secrets (Must be overridden in production)
JWT_SECRET=replace_with_a_cryptographically_secure_random_jwt_secret_min_32_chars
CORS_ORIGIN=http://localhost:5173

# Database Configuration
AEGIS_DB_PATH=./data/aegispulse.sqlite

# Telemetry Gating Thresholds
MIN_OPTICAL_CONFIDENCE_THRESHOLD=0.60
MIN_OPTICAL_SNR_THRESHOLD_DB=1.0

# Web Frontend
VITE_API_URL=http://localhost:3000

# Logging & Auditing
LOG_LEVEL=info
SANITIZED_LOGS=true
