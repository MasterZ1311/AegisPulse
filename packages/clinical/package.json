{
  "name": "@aegispulse/clinical",
  "version": "0.1.0",
  "private": true,
  "description": "Clinical calculation engine and early warning scoring for AegisPulse",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mews": {
      "types": "./dist/mews/index.d.ts",
      "default": "./dist/mews/index.js"
    },
    "./qsofa": {
      "types": "./dist/qsofa/index.d.ts",
      "default": "./dist/qsofa/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "calibrate": "node dist/calibration/cli.js"
  },
  "dependencies": {
    "@aegispulse/types": "*"
  },
  "devDependencies": {
    "@aegispulse/config": "*",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
